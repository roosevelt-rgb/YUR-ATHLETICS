# YUR Athletics: what never enters this public repository, even if someone copies it into the tree later.
# Athlete records and everything built from them, family and coach contacts, the team's game data, accounts,
# runtimes and build output stay on the machine that makes them. Nested .gitignore files repeat the rules.

# ---- secrets and local configuration (any folder) ----
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.pfx
*.p12
*.secret
*credentials*.json
anthropic-env-backup.txt
.keys/
secrets/
.yur_data/
.yur-runtime/
*.local.json

# ---- credential files, key stores and saved logins (any folder) ----
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
.ssh/
.gnupg/
.aws/
.azure/
.kube/
.npmrc
.yarnrc.yml
.pypirc
.netrc
_netrc
.git-credentials
client_secret*.json
token.json
token.pickle
*.token
service-account*.json
serviceAccountKey*.json
*storage_state*.json
*storageState*.json
.auth/
cookies*.txt
*.har
*.jks
*.keystore
*.p8
*.ppk
*.kdbx
secrets.*
.firebaserc
