# ---- desktop/ ----
# The athlete manifest is each owner's own file; the repo ships editions/athletics.example.json.
desktop/editions/*
!desktop/editions/athletics.example.json
desktop/.desktop-python/
desktop/.desktop-models/
desktop/.factory-state/
desktop/.factory-sources.local.json
desktop/.forge-*.txt
desktop/.specialist-forge-*.txt
desktop/In my ecosystem*.md
desktop/Paste-ready prompt*.md
# The Hermes skill snapshot is imported locally (scripts/import_hermes_skills.py) and not published.
desktop/integrations/hermes_skills/

# ---- gridiron/ ----
# Private data: only the README and the fictional samples are public.
gridiron/recruit/data/*
!gridiron/recruit/data/README.md
!gridiron/recruit/data/sample/
# inside sample/ only the named fictional files ship; anything else put there stays out
gridiron/recruit/data/sample/**
!gridiron/recruit/data/sample/athletes/
!gridiron/recruit/data/sample/athletes/quinn-placeholder.json
!gridiron/recruit/data/sample/athletes/quinn-placeholder.package.json
